# LittleFS capture profile for ESP32-C5 N32R8, ESP-IDF 6.0.2.
CONFIG_IDF_TARGET="esp32c5"
CONFIG_BUILD_CONFIG_TEMPLATE="ESP32-C5 N32R8 Capture"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_c5_n32r8_capture.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LITTLEFS_MALLOC_STRATEGY_SPIRAM_PREFER=y
# BLE sources currently require NimBLE at compile time.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_FREERTOS_HZ=1000
# Receive-focused device: keep RX optimization and buffers, reduce TX capacity
# and optional instruction-RAM speed optimizations to preserve internal heap.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
# Shared GUI translation units still require these fonts.
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
# Avoid LVGL's otherwise reserved 32 KiB static internal memory arena.
CONFIG_LV_MEM_CUSTOM=y
# CONFIG_LV_BUILD_EXAMPLES is not set
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_CAPTURE_STORAGE_LITTLEFS=y
# CONFIG_CAPTURE_LITTLEFS_FORMAT_IF_FAILED is not set
# CONFIG_WITH_SCREEN is not set
# CONFIG_ENABLE_GHOSTSCRIPT is not set
# CONFIG_ENABLE_NATIVE_SD_APPS is not set
# CONFIG_HAS_GPS is not set
# CONFIG_USING_SPI is not set
# CONFIG_USING_MMC is not set
# CONFIG_USING_MMC_1_BIT is not set
